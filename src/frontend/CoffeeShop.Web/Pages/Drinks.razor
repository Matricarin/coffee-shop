@page "/drinks"
@using System.Globalization
@using CoffeeShop.Web.Models
@using CoffeeShop.Web.Services
@inject DrinksService DrinksService

<PageTitle>Drinks</PageTitle>

<div class="container mt-4">
    <h2>Drinks</h2>
    <hr/>

    @if (_drinks is null)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка ..</span>
        </div>
    }
    else if (!_drinks.Any())
    {
        <div class="alert alert-warning">Товары не найдены</div>
    }
    else
    {
        <div class="row">
            @foreach (var drink in _drinks)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center" style="height: 200px;">
                            <img src="@drink.PictureUrl" alt="image" style="width: 150px; margin-right: 5px">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@drink.Name</h5>
                            <p class="card-text text-muted">@drink.Description</p>
                            <div class="mt-auto">
                                <h6 class="text-primary fw-bold">@drink.Price.ToString("C", new CultureInfo("en-US"))</h6>
                                <button class="btn btn-primary w-100 mt-2" @onclick="() => AddToCart(drink)">
                                    Add to cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DrinkItem>? _drinks;

    protected override async Task OnInitializedAsync()
    {
        _drinks = await DrinksService.GetDrinksAsync();
    }

    private void AddToCart(DrinkItem drink)
    {
        Console.WriteLine($"{drink.Name} was added to cart.");
    }

}