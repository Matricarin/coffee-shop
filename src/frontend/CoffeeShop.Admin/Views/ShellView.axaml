<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="CoffeeShop.Admin.Views.ShellView"
             xmlns:vm="clr-namespace:CoffeeShop.Admin.ViewModels"
             x:DataType="vm:ShellViewModel">

    <Design.DataContext>
        <vm:ShellViewModel/>
    </Design.DataContext>

    <DockPanel>

        <DockPanel.Background>
            <LinearGradientBrush EndPoint="100%,100%" StartPoint="0%,0%">
                <GradientStop Color="#0C6170" Offset="0" />
                <GradientStop Color="#84898C" Offset="1" />
            </LinearGradientBrush>
        </DockPanel.Background>

        <Button DockPanel.Dock="Bottom" 
                Content="Выйти"
                Margin="10"/>

        <ListBox Width="180"
                 DockPanel.Dock="Left"
                 Background="#0C6170"
                 CornerRadius="12"
                 Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="Наименование"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
       
        <ContentControl Content="{Binding CurrentPage}"/>
    </DockPanel>

</UserControl>
